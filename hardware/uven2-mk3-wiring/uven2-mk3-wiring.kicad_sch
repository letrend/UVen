  (text_box "these are the thermistor connections. polarity does not matter"
    (at 22.733 198.628 0) (size 16.891 12.192)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid 074c9796-7717-43c0-bb2d-50dbe3447a86)
  )
  (text_box "USE AWG 14/16 copper wires for all 12V/GND supply lines.\neach cable needs to be able to handle at least 10A"
    (at 58.801 509.016 0) (size 22.225 15.494)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid 2e7c248f-39ea-4000-9318-b96ac9fa5a8b)
  )
  (text_box "DISPLAY PROGRAMMING/UART PORT"
    (at 340.36 224.282 0) (size 22.225 8.255)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid 71bd6ef1-dae2-4fba-a5af-56012fdbb2dd)
  )
  (text_box "use 230V wires rated for 1.5kW.\nif you dont know, better ask somebody who does, to wire this up for you properly ;)"
    (at 322.58 512.572 0) (size 22.225 15.494)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid 73fe18f7-3f2f-4d1d-88c4-4b6715931d8d)
  )
  (text_box "OPTIONAL i2c interface.\nQWICC connectors.\nFor example for additional temperature sensors\n"
    (at 345.186 157.48 0) (size 24.511 14.097)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid 8ff43ebf-1aa5-4c88-b28b-48add3b48ac4)
  )
  (text_box "Polarity does NOT matter for the interlock switches and the emergency OFF button\n"
    (at 362.966 182.245 0) (size 34.925 8.509)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid ab006a2d-ebc6-478c-bbea-81788ab64135)
  )
  (text_box "all fans in parallel, pay attention to the polarity"
    (at 288.036 273.304 0) (size 22.225 8.255)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid b4b6cf2d-8d41-4335-9805-c14ddf44a657)
  )
  (text_box "all fans in parallel, pay attention to the polarity"
    (at 370.713 341.757 0) (size 22.225 8.255)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid c261a095-cb43-46fc-b63f-04b415418fe1)
  )
  (text_box "CAREFUL!!!!\ndo NOT use the flatband cable that comes with the display! using it will damage the display, because the polarity is inversed.\nyou have to use the straight connected flatband cable"
    (at 221.234 98.933 0) (size 25.146 22.479)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid d6188dda-a337-4e95-91f1-d8a5f4f66f77)
  )

